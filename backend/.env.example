# Application Port
PORT=5000

# MongoDB Atlas Connection
# Replace <db_password> with the password for the 24aiml014_db_user database user
MONGODB_USERNAME=24aiml014_db_user
MONGODB_PASSWORD=<db_password>
MONGODB_DATABASE=Task
MONGO_URI=mongodb+srv://24aiml014_db_user:<db_password>@cluster0.cgze1oc.mongodb.net/Task?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://24aiml014_db_user:<db_password>@cluster0.cgze1oc.mongodb.net/Task?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL
FRONTEND_URL=http://localhost:5173

# Email Service (Nodemailer / SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SERVICE=gmail
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_specific_password
MAIL_FROM="Task Manager <your_email@gmail.com>"

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_REPORT_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
